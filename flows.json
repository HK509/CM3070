    {
        "id": "7afa69a439f6d4c7",
        "type": "function",
        "z": "3fe09573e6a332bc",
        "name": "Sensor Data Splitter",
        "func": "//get the incoming raw serial text line\nlet incomingLine = msg.payload.toString().trim();\n\n//check if the string is the output from a sensor reading packet, if it is then process it\nif (incomingLine.includes(\"Temperature:\") && incomingLine.includes(\"|\")) {\n\n    //isolate the sensor text out of the sentence structure\n    //the usual line layout is like: Temperature: 23.80 °C | Humidity: 69.00 % | Water Level Distance: 9.88 cm | Soil Moisture Level: 796\"\n    let temperaturePart = incomingLine.split(\"Temperature: \")[1].split(\" °C\")[0];\n    let humidityPart = incomingLine.split(\"Humidity: \")[1].split(\" %\")[0];\n    let waterLevelPart = incomingLine.split(\"Water Level Distance: \")[1].split(\" cm\")[0];\n    let soilMoisturePart = incomingLine.split(\"Soil Moisture Level: \")[1].trim();\n\n    //cache variables inside memory storage\n    flow.set(\"lastTemperature\", temperaturePart);\n    flow.set(\"lastHumidity\", humidityPart);\n    flow.set(\"lastWaterLevel\", waterLevelPart);\n    flow.set(\"lastSoilMoisture\", soilMoisturePart);\n\n    //format the variables so they are suitable for the chart\n    let chartTemperature = { topic: \"Temperature (°C)\", payload: temperaturePart };\n    let chartHumidity  = { topic: \"Humidity (%)\", payload: humidityPart };\n    let chartWaterLevel = { topic: \"Water Distance (cm)\", payload: waterLevelPart };\n    let chartSoilMoisture  = { topic: \"Soil Moisture\", payload: soilMoisturePart };\n\n    //now route the filtered floating-point variables\n    return [\n        { payload: parseFloat(temperaturePart) },// Temperature Gauge\n        { payload: parseFloat(humidityPart) },//Humidity Gauge\n        { payload: parseFloat(waterLevelPart) },// Water level Gauge\n        { payload: parseInt(soilMoisturePart) },//Soil Moisture Gauge\n        [chartTemperature, chartHumidity, chartWaterLevel, chartSoilMoisture]\n    ];\n}\n\n// any other unformatted serial logs or connection helper texts are disregarded\nreturn null;",
        "outputs": 5,
        "timeout": 0,
        "noerr": 0,
        "initialize": "",
        "finalize": "",
        "libs": [],
        "x": 580,
        "y": 160,
        "wires": [
