    {
        "id": "34bb72a408c1eeae",
        "type": "function",
        "z": "3fe09573e6a332bc",
        "name": "GPS Pin Generator",
        "func": "// define local prototype coordinate matrices\n// use London Regents Park for disaster monitoring simulation as an example\nlet centerLat = 51.5284;\nlet centerLon = -0.1544;\n\n//build the multi-node geospatial payload tracker arrays\nlet markers = [\n    {\n        command: \"addmarker\",\n        name: \"Sensor Node (Node 1)\",\n        lat: centerLat + 0.0005,\n        lon: centerLon - 0.0004,\n        icon: \"fa-rss\",\n        iconColor: \"green\",\n        layer: \"Field Infrastructure\",\n        message: \"Environment Sensor Node\"\n    },\n\n    {\n        command: \"addmarker\",\n        name: \"Mitigation Actor (Node 2)\",\n        lat: centerLat - 0.0004,\n        lon: centerLon + 0.0005,\n        icon: \"fa-gear\",\n        iconColor: \"darkred\",\n        layer: \"Actuator Infrastructure\",\n        message: \"Physical Servo Floodgate and Crop Irrigation Pump Relays\"\n    },\n\n    {\n        command: \"addmarker\",\n        name: \"Alert Gateway Node (Node 3)\",\n        lat: centerLat,\n        lon: centerLon,\n        icon: \"fa-shield\",\n        iconColor: \"blue\",\n        layer: \"Gateway Core\",\n        message: \"Fuzzy Logic Computational Hub Engine & Dashboards\"\n    }\n];\n\n//loop through each marker and push it to the map node\nmarkers.forEach(function(marker) {\n    node.send({ payload: marker });\n});",
        "outputs": 1,
        "timeout": 0,
        "noerr": 0,
        "initialize": "",
        "finalize": "",
        "libs": [],
        "x": 630,
        "y": 1160,
