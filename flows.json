    {
        "id": "077afd762b3d8b7e",
        "type": "function",
        "z": "3fe09573e6a332bc",
        "name": "Cache Reloader",
        "func": "//pull the cached variables back out from flow state memory storage\n//if a variable is empty, it safely defaults to 0.0 baseline indicators\nreturn [\n    { payload: flow.get(\"lastTemperature\") || 0.0 },  //output 1 -> Temperature Gauge\n    { payload: flow.get(\"lastHumidity\") || 0.0 },   //output 2 -> Humidity Gauge\n    { payload: flow.get(\"lastWaterLevel\") || 0.0 }, //output 3 -> Water Level Gauge\n    { payload: flow.get(\"lastSoilMoisture\") || 0 }     //output 4 -> Soil Moisture Gauge",
